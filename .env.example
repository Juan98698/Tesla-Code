# Solo servidor. Copia este archivo a .env.local para trabajar en tu equipo.
# En Vercel configura estas variables en Project Settings > Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Orígenes exactos separados por comas. Incluye el dominio de la web publicada.
# En local se admiten únicamente los orígenes loopback del propio servidor.
TUTOR_ALLOWED_ORIGINS=

# Contadores compartidos en producción, integración Upstash Redis de Vercel.
# El modo local utiliza contadores en memoria; producción exige Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TUTOR_IP_HASH_SECRET=

# Cuotas de solicitudes, no un presupuesto monetario del proveedor.
TUTOR_PER_MINUTE=20
TUTOR_PER_IP_DAY=200
TUTOR_GLOBAL_DAY=1000
